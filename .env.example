# ==============================================================================
# Progressive Credential Loading (PCL) Configuration
# Repository: multimodal-document-processor
# ==============================================================================
#
# TIER 1: ZERO-SETUP / LOCAL DEV / CI (Default)
# - No OpenAI API key required.
# - OCR extraction runs with Tesseract and heuristic fallback for layouts/tables.
#
# TIER 2: LOCAL DEV WITH LIVE VISION AI
# - Supply an OpenAI API key (sk-...) to activate live GPT-4o vision analysis
#   for charts, complex tables, diagrams, and deep semantic extraction.
#
# TIER 3: PRODUCTION KUBERNETES DEPLOYMENT
# - Inject credentials via Kubernetes Secrets or Helm values.
#
# ── AI Vision Provider ────────────────────────────────────────────────────────
# UNSET or sk-dummy (default): Heuristic & local OCR mode (CI-safe)
# SET to real sk-... key: Live GPT-4o multimodal vision extraction
OPENAI_API_KEY=

# ── OCR Engine Path ──────────────────────────────────────────────────────────
TESSERACT_CMD=/usr/bin/tesseract

# ── Storage & Limits ──────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50
STORAGE_DIR=storage
